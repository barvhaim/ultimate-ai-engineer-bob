{
  "$schema": "https://bobshell.io/schemas/settings.schema.json",
  "_comment": "Project-scoped MCP servers for AI engineering. Bob auto-loads from <cwd>/.bob/settings.json. Servers needing API keys read them from env vars at runtime — see README.md. Restrict per-session: bob --allowed-mcp-server-names hf-mcp context7 arxiv",
  "mcpServers": {
    "hf-mcp": {
      "_comment": "Hugging Face Hub: search models/datasets/spaces, run jobs, query Spaces as tools",
      "command": "npx",
      "args": ["-y", "@huggingface/mcp-server"],
      "env": {
        "HF_TOKEN": "${HF_TOKEN}"
      }
    },
    "context7": {
      "_comment": "Live library docs — prevents API hallucination",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "arxiv": {
      "_comment": "Paper search + abstract retrieval",
      "command": "uvx",
      "args": ["arxiv-mcp-server"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "e2b": {
      "_comment": "Sandboxed code execution — run untrusted code without touching the host",
      "command": "npx",
      "args": ["-y", "@e2b/mcp-server"],
      "env": {
        "E2B_API_KEY": "${E2B_API_KEY}"
      }
    },
    "semgrep": {
      "_comment": "Static security analysis — used by /audit and security-auditor mode",
      "command": "uvx",
      "args": ["semgrep-mcp"]
    }
  }
}
